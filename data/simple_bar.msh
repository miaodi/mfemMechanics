MFEM mesh v1.0

#
# MFEM Geometry Types (see mesh/geom.hpp):
#
# POINT       = 0
# SEGMENT     = 1
# TRIANGLE    = 2
# SQUARE      = 3
# TETRAHEDRON = 4
# CUBE        = 5
#
# Geometry and j2_tensile boundary conditions (not to scale):
#
#                 boundary 2: prescribed u_y
#                       2---------5
#                       |         |
#      boundary 4: free  |         | boundary 3: free
#                       1---------4
#                       |         |
#                       |         |
#                       0---------3
#                         boundary 1: u_x = u_y = 0
#
# Boundary-condition labels describe the j2_tensile example, not constraints
# stored by the mesh format.

dimension
2

# Element record format:
#   <material-attribute> <geometry-type> <vertex-0> ... <vertex-N>
# Geometry type 3 is a quadrilateral with four counterclockwise vertices.
elements
2
1 3 0 3 4 1
1 3 1 4 5 2

# Boundary record format:
#   <boundary-attribute> <geometry-type> <vertex-0> <vertex-1>
# Geometry type 1 is a segment. Boundary attributes label edges; j2_tensile
# fixes both components on attribute 1 and prescribes u_y on attribute 2.
boundary
6
1 1 0 3
2 1 5 2
3 1 3 4
3 1 4 5
4 1 2 1
4 1 1 0

vertices
6
2
0  0
0  1
0  2
1  0
1  1
1  2
